<IfModule mod_rewrite.c>
    RewriteEngine On

    # Tenta forçar CORS via Header (se o host permitir)
    Header set Access-Control-Allow-Origin "https://v0-app-nexora-bjj.vercel.app"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"
    Header set Access-Control-Allow-Credentials "true"

    # Permite que requisições OPTIONS passem para o PHP
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ public/index.php [L,QSA]

    # Redireciona a raiz para public/index.php
    RewriteRule ^$ public/index.php [L]

    # Se o arquivo ou diretório solicitado não existir, manda para o public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php/$1 [L,QSA]
</IfModule>
