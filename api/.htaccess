<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── CRÍTICO: Repassa o header Authorization ao PHP ──────────────
    # O Apache descarta Authorization por padrão; esta regra o preserva.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Permite que requisições OPTIONS passem para o PHP
    # (o PHP em index.php trata CORS dinamicamente — não fixar origem aqui)
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ public/index.php [L,QSA]

    # Redireciona a raiz para public/index.php
    RewriteRule ^$ public/index.php [L]

    # Se o arquivo ou diretório solicitado não existir, manda para o public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php/$1 [L,QSA]
</IfModule>

